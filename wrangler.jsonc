{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openai-web-mcp",
  "main": "src/index.ts",
  "preview_urls": false,
  "compatibility_date": "2026-10-12",
  // global_fetch_strictly_public: fetch() refuses private/internal addresses (SSRF defence in
  // depth for web_fetch's direct fallback) and enables OAuth client-ID metadata documents.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "PUBLIC_ORIGIN": "https://openai-web-mcp.gmathur1993.workers.dev",
    // Hard cap on upstream alpha/search calls per UTC day (search + fetch combined).
    "DAILY_LIMIT": "400",
    // Model id sent with alpha/search; required by the endpoint, not validated by it.
    "CODEX_MODEL": "gpt-5.4-mini",
    // Optional search localisation (strong effect, verified live). Unset/empty = global.
    "SEARCH_COUNTRY": "IN",
    "SEARCH_CITY": "",
    "SEARCH_TIMEZONE": "Asia/Kolkata",
    // chatgpt.com blocks Cloudflare Workers' egress IPs (findings §12), so alpha/search goes through
    // the stateless Render relay (findings §14). RELAY_SECRET is a Worker secret (>= 32 chars).
    "RELAY_URL": "https://openai-web-relay.onrender.com",
    // Optional comma-separated hostnames never returned by web_search.
    "BLOCKED_DOMAINS": "",
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "TokenVault" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TokenVault"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openai-web-mcp",
      "database_id": "85eb6e11-cd13-433a-842a-250a44141f57",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "1151c4ea20754c1da077c35671597bfb" },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
}
